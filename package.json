{
  "name": "holy-auramaxxxing",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:db": "supabase test db",
    "lighthouse": "lhci autorun --config=lighthouserc.public.json && lhci autorun --config=lighthouserc.auth.json && node scripts/lighthouse-session.mjs && lhci autorun --config=.lighthouseci/lighthouserc.app.json",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run build",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/supabase/database.types.ts",
    "email:test": "node scripts/send-test-email.mjs",
    "accounts:purge": "node scripts/accounts-purge.mjs",
    "notify:fire": "node scripts/notify-fire.mjs",
    "notify:configure": "node scripts/notify-configure.mjs",
    "notify:doctor": "node scripts/notify-doctor.mjs",
    "bench:notify": "node scripts/bench-notify.mjs"
  },
  "dependencies": {
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.2",
