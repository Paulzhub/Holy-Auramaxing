# Copy to .env.local and fill in. Never commit .env.local.
# Values for local development come from `npx supabase start` (or `npx supabase status`).

# Public site URL, used for canonical links and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (local: http://127.0.0.1:54321). Production project lives in Mumbai (ap-south-1).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# "Publishable key" from `npx supabase status` (starts with sb_publishable_).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. "Secret key" from `npx supabase status` (starts with sb_secret_).
# Never prefix with NEXT_PUBLIC_ and never import it into client code. Not used until Phase 2.
SUPABASE_SECRET_KEY=

# Shows /dev/components in production builds (on automatically in `npm run dev`).
ENABLE_DEV_PAGES=false
