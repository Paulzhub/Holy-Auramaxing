# Copy to .env.local and fill in. Never commit .env.local.
# Values for local development come from `npx supabase start` (or `npx supabase status`).

# Public site URL, used for canonical links and metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (local: http://127.0.0.1:54321). Production project lives in Mumbai (ap-south-1).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# "Publishable key" from `npx supabase status` (starts with sb_publishable_).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. "Secret key" from `npx supabase status` (starts with sb_secret_).
# Never prefix with NEXT_PUBLIC_ and never import it into client code.
SUPABASE_SECRET_KEY=

# Cloudflare Turnstile site key. Leave empty locally (the widget is hidden and
# Supabase's captcha is off). In production, also enable Turnstile with the
# secret key in the Supabase dashboard. See docs/decisions.md D-018.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Upstash Redis for shared rate limits in production. Empty = in-memory (one process).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Server-only. Encrypts private text such as "my why" (AES-256-GCM, D-025).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it secret and never change it once real data exists (old text couldn't be read).
APP_ENCRYPTION_KEY=

# Server-only. Google Cloud Vision API key, restricted to the Cloud Vision API.
# Screens uploaded profile photos for nudity before anyone else sees them (D-026).
GOOGLE_CLOUD_VISION_API_KEY=
# Optional override: google | stub | none. Unset = google when the key is set,
# stub under `npm run dev`, none (photos wait unpublished) in any other build.
# "stub" approves every photo except solid magenta; use it only for tests.
IMAGE_SCREENING_PROVIDER=

# Set to true only when working offline: skips the Have I Been Pwned password check.
HIBP_DISABLED=false

# Mailpit (local email inbox): `npx supabase status` shows it. The app's own
# security emails go here when EMAIL_PROVIDER=mailpit, and e2e tests read it.
MAILPIT_URL=http://127.0.0.1:54324

# Who sends the app's own emails (security alerts, D-030): resend | smtp | mailpit | none.
# Unset = resend when RESEND_API_KEY is set, else smtp when SMTP_HOST is set,
# else mailpit when MAILPIT_URL is set. Keep "mailpit" locally so testing never
# emails anyone; use "smtp" (Gmail) or "resend" in production.
EMAIL_PROVIDER=mailpit
# Server-only. Resend API key (production). Without a verified domain, Resend
# only delivers to the Resend account owner's own address.
RESEND_API_KEY=
# Server-only. SMTP for EMAIL_PROVIDER=smtp (D-031). For a small launch with no
# domain: a dedicated Gmail account with 2-step verification and an app password.
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_USER=the.gmail.address@gmail.com
#   SMTP_PASSWORD=the 16-letter app password (not the account password)
# Check them with:  npm run email:test -- you@example.com
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Sender for the app's emails, e.g. "Aura <hello@your-domain>". With Gmail SMTP,
# leave it empty: it defaults to "Aura <SMTP_USER>" (Gmail only sends as itself). Unset = Resend's
# test sender (onboarding@resend.dev) with Resend, or a local address with Mailpit.
EMAIL_FROM=

# Passkeys (Supabase beta, D-029): on only when "true". Read on the server at run
# time, so it works as a kill switch without rebuilding. Locally, open the app
# at http://localhost:3000 (not 127.0.0.1) or passkeys won't work.
PASSKEYS_ENABLED=true

# Shows /dev/components in production builds (on automatically in `npm run dev`).
ENABLE_DEV_PAGES=false
