# Copy to supabase/.env (git-ignored). Read by `npx supabase start`.
# Google OAuth client (Google Cloud Console → APIs & Services → Credentials).
# Authorised redirect URI: http://127.0.0.1:54321/auth/v1/callback
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=set-me.apps.googleusercontent.com
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=set-me
